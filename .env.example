# Database Configuration
DATABASE_URL=postgresql+asyncpg://bodam:bodam_password@localhost:5432/bodam

# Redis Configuration
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_SEMANTIC_URL=redis://localhost:6379/1

# Backend Security
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
ADMIN_SECRET_KEY=your_admin_secret_key_32_chars_min

# Semantic Cache Settings
SEMANTIC_CACHE_TTL=300
SEMANTIC_SIMILARITY_THRESHOLD=0.95

# API Keys
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_LOGIN_CLIENT_ID=your_naver_login_client_id
NAVER_LOGIN_CLIENT_SECRET=your_naver_login_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_API_KEY=your_youtube_api_key
TOGETHER_AI_API_KEY=your_together_ai_api_key
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key

# Firebase
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Grafana Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BODAM_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# DB 연결 풀 설정
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=0.4

# HTTP 연결 풀 설정
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=60.0

# HTTP 타임아웃 설정
HTTP_CONNECT_TIMEOUT=4.0
HTTP_READ_TIMEOUT=8.0
HTTP_WRITE_TIMEOUT=10.0
HTTP_POOL_TIMEOUT=10.0

# 결제 API 타임아웃 설정 (8초 기본)
HTTP_PAYMENT_CONNECT_TIMEOUT=180.0
HTTP_PAYMENT_READ_TIMEOUT=180.0

# Retry 정책 설정
RETRY_MAX_ATTEMPTS=3
RETRY_INTERVAL=4.0
RETRY_EXCLUDED_DOMAINS=api.tosspayments.com,pay.naver.com
