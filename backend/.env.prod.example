# Production Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/bodam
REDIS_URL=redis://redis:6379

# Security - Production (RS256)
# For RS256, you need to generate RSA key pair:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...your-private-key...
-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...your-public-key...
-----END PUBLIC KEY-----"
ACCESS_TOKEN_TTL=60
PASSWORD_RESET_TOKEN_TTL=15

# Cookies
COOKIE_DOMAIN=.bodam.example
COOKIE_SECURE=true
COOKIE_SAMESITE=None

# CORS
ALLOWED_ORIGINS=https://app.bodam.example,https://admin.bodam.example,https://frontend-sigma-pearl-65.vercel.app,https://frontend-wheat-bodam.vercel.app,https://bodam.website,https://www.bodam.website

# External APIs
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id

# Toss Payments
TOSS_CLIENT_KEY=your-production-toss-client-key
TOSS_SECRET_KEY=your-production-toss-secret-key

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@bodam.example
SMTP_PASSWORD=your-smtp-password

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_MONITORING=true
DEBUG=false

# Monitoring
PROMETHEUS_PUSHGATEWAY_URL=http://prometheus-pushgateway:9091
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
