# Development Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://bodam:bodam@localhost:5432/bodam

# === DB 연결 풀 설정 ===
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=0.4

# Redis (K8s 분리 배포)
REDIS_CACHE_URL=redis://redis-cache-service:6379/0
# REDIS_URL=redis://localhost:6379  # Deprecated: Use REDIS_CACHE_URL instead

# Semantic Cache (Redis Stack + Vector)
REDIS_SEMANTIC_URL=redis://redis-semantic-service:6379/0
EMBED_PROVIDER=together
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
# EMBED_API_KEY is injected via secrets in non-local environments

# Mock site source
MOCK_SITE_BASE_URL=https://dlehdgml5328.github.io/mock-fire-station-site

# Celery
CELERY_BROKER_URL=redis://redis-queue-service:6379/0
CELERY_RESULT_BACKEND=redis://redis-queue-service:6379/1

# Security - Development (HS256)
JWT_SECRET=dev-jwt-secret-key-for-bodam-project-must-be-long-enough-for-hmac-algorithm
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=1440
PASSWORD_RESET_TOKEN_TTL=30

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# CORS - Frontend development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External APIs
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id
YOUTUBE_API_KEY=your-youtube-api-key

# Together AI (Llama 3.3)
TOGETHER_AI_API_KEY=your-together-api-key
TOGETHER_AI_MODEL=meta-llama/Meta-Llama-3.3-70B-Instruct-Turbo

# Toss Payments (Toss 테스트 키)
TOSS_CLIENT_KEY=test_ck_oEjb0gm23PYMm6epMNvoVpGwBJn5
TOSS_SECRET_KEY=test_sk_ORzdMaqN3wOaB4nZdd1b35AkYXQG

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=dev@bodam.example
SMTP_PASSWORD=dev-password

# === HTTP 연결 풀 설정 ===
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=60.0

# === HTTP 타임아웃 설정 ===
HTTP_CONNECT_TIMEOUT=4.0
HTTP_READ_TIMEOUT=8.0
HTTP_WRITE_TIMEOUT=10.0
HTTP_POOL_TIMEOUT=10.0

# === 결제 API 타임아웃 설정 ===
HTTP_PAYMENT_CONNECT_TIMEOUT=180.0
HTTP_PAYMENT_READ_TIMEOUT=180.0

# === 재시도 설정 ===
RETRY_MAX_ATTEMPTS=3
RETRY_INTERVAL=4.0
RETRY_EXCLUDED_DOMAINS=api.tosspayments.com,pay.naver.com

# Feature Flags
ENABLE_RATE_LIMITING=false
ENABLE_MONITORING=false
DEBUG=true

# SQLAdmin Configuration
SQLADMIN_SECRET_KEY=dev-sqladmin-secret-key-must-be-random-32-chars
SQLADMIN_SESSION_TIMEOUT=3600
