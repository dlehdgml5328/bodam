# Development Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bodam_dev
REDIS_URL=redis://localhost:6379

# Security - Development (HS256)
JWT_SECRET=your-dev-secret-key-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=1440
PASSWORD_RESET_TOKEN_TTL=30

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External APIs
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id

# Toss Payments
TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=dev@bodam.example
SMTP_PASSWORD=dev-password

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_MONITORING=false
DEBUG=true