apiVersion: 1

groups:
  - orgId: 1
    name: BoDam Production Alerts
    folder: Alerts
    interval: 1m
    rules:
      # 1. API 응답 속도 알람 (p95 > 300ms)
      - uid: api_p95_high
        title: "🐌 API 응답 속도 느림 (p95 > 300ms)"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000
              refId: A
          - refId: C
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 300
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: Alerting
        for: 2m
        annotations:
          summary: "API p95 응답 속도가 300ms를 초과했습니다"
          description: "현재 p95 응답시간: {{ $values.A.Value }}ms. 성능 저하가 감지되었습니다."
        labels:
          severity: warning
          component: backend

      # 2. API 응답 속도 심각 (p95 > 1000ms)
      - uid: api_p95_critical
        title: "🔥 API 응답 속도 심각 (p95 > 1초)"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) * 1000
              refId: A
          - refId: C
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 1000
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: Alerting
        for: 1m
        annotations:
          summary: "API 응답 속도가 1초를 초과했습니다!"
          description: "현재 p95 응답시간: {{ $values.A.Value }}ms. 즉시 확인이 필요합니다."
        labels:
          severity: critical
          component: backend

      # 3. HTTP 4xx 에러율 높음 (> 10%)
      - uid: http_4xx_high
        title: "⚠️ HTTP 4xx 에러율 높음 (> 10%)"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              expr: |
                sum(rate(http_requests_total{status=~"4.."}[5m]))
                /
                sum(rate(http_requests_total[5m])) * 100
              refId: A
          - refId: C
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 10
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: Alerting
        for: 3m
        annotations:
          summary: "HTTP 4xx 에러율이 10%를 초과했습니다"
          description: "현재 4xx 에러율: {{ $values.A.Value }}%. 클라이언트 요청 문제가 발생하고 있습니다."
        labels:
          severity: warning
          component: backend

      # 4. HTTP 5xx 에러 발생
      - uid: http_5xx_detected
        title: "🚨 HTTP 5xx 서버 에러 발생"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              expr: sum(rate(http_requests_total{status=~"5.."}[5m])) > 0
              refId: A
          - refId: C
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: Alerting
        for: 1m
        annotations:
          summary: "서버 에러(5xx)가 발생했습니다!"
          description: "5xx 에러 발생률: {{ $values.A.Value }}/s. 즉시 확인이 필요합니다."
        labels:
          severity: critical
          component: backend

      # 5. 중복 기부 감지 (> 5건)
      - uid: duplicate_donation_detected
        title: "🔄 중복 기부 감지됨 (> 5건)"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              expr: sum(increase(bodam_donation_duplicate_total[10m]))
              refId: A
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 5
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: OK
        for: 2m
        annotations:
          summary: "중복 기부 시도가 감지되었습니다"
          description: "최근 10분간 {{ $values.A.Value }}건의 중복 기부 시도. Race condition 확인 필요."
        labels:
          severity: warning
          component: donations

      # 6. DB 커넥션 풀 고갈 (사용률 > 80%)
      - uid: db_pool_exhaustion
        title: "💾 DB 커넥션 풀 고갈 위험 (> 80%)"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              expr: |
                (db_connection_pool_in_use / db_connection_pool_size) * 100
              refId: A
          - refId: C
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 80
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: Alerting
        for: 2m
        annotations:
          summary: "DB 커넥션 풀 사용률이 80%를 초과했습니다"
          description: "현재 사용률: {{ $values.A.Value }}%. DB 커넥션 부족 위험."
        labels:
          severity: warning
          component: database

      # 7. DB 데드락 발생
      - uid: db_deadlock_detected
        title: "🔒 DB 데드락 발생"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: prometheus
            model:
              expr: sum(increase(db_deadlocks_total[5m]))
              refId: A
          - refId: C
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 0
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: OK
        for: 1m
        annotations:
          summary: "데이터베이스 데드락이 발생했습니다"
          description: "최근 5분간 {{ $values.A.Value }}건의 데드락 발생. 트랜잭션 확인 필요."
        labels:
          severity: critical
          component: database

      # 8. Celery 작업 실패율 높음 (> 20%)
      - uid: celery_failure_rate_high
        title: "⚙️ Celery 작업 실패율 높음 (> 20%)"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: prometheus
            model:
              expr: |
                sum(rate(celery_tasks_total{status="FAILURE"}[10m]))
                /
                sum(rate(celery_tasks_total[10m])) * 100
              refId: A
          - refId: C
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator:
                    params:
                      - 20
                    type: gt
                  operator:
                    type: and
                  query:
                    params:
                      - C
                  type: query
              refId: C
        noDataState: NoData
        execErrState: OK
        for: 3m
        annotations:
          summary: "Celery 작업 실패율이 20%를 초과했습니다"
          description: "현재 실패율: {{ $values.A.Value }}%. 백그라운드 작업 확인 필요."
        labels:
          severity: warning
          component: celery
